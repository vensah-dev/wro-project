{
  // "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*.ts", "src/preload/**/*.ts"],
  "exclude": ["src/**/*.js", "src/main/**/*", "src/preload/**/*", "node_modules"],
  "compilerOptions": {
